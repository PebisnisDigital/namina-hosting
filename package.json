{
  "name": "cinematic-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:hosting": "vite build --outDir hosting-dist && node scripts/prepare-hosting.mjs",
    "build:pages": "vite build --outDir pages-dist --base=/namina-hosting/ && node scripts/prepare-pages-preview.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:generator-api": "node --import tsx tests/php/generator-api.test.ts",
    "test:hosting": "playwright test --config playwright.hosting.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "mp4box": "^2.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
